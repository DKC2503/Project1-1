# --- server configuration ---
PORT=5000
NODE_ENV=production
APP_URL=https://newspercent.com
ALLOWED_ORIGINS=https://newspercent.com,https://www.newspercent.com

# --- database configuration ---
# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/newspercent?retryWrites=true&w=majority

# --- security configuration ---
# Secret for JWT Token Signatures (use a long random string)
JWT_SECRET=

# --- cloudinary credentials (fallback & article uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- cloudinary credentials (profile uploads - optional if using same as above) ---
PROFILE_CLOUDINARY_CLOUD_NAME=your_profile_cloudinary_cloud_name
PROFILE_CLOUDINARY_API_KEY=your_profile_cloudinary_api_key
PROFILE_CLOUDINARY_API_SECRET=your_profile_cloudinary_api_secret

# --- email/smtp credentials (otp sending) ---
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# --- external API keys (weather, precious metals/gold, fuel) ---
WEATHER_API_KEY=your_weather_api_key
PRECIOUS_METALS_API_KEY=your_gold_api_io_key
FUEL_API_KEY=your_indianapi_fuel_key

GEMINI_API_KEY=
